        <mxCell id="1vnI9REiS84Y3yM3PkD3-65" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="$$\begin{bmatrix} \hat{y}_1 \\ \hat{y}_2 \\ \vdots \\ \hat{y}_{N_{ss}} \end{bmatrix} = \begin{bmatrix} \sigma_1 &amp;amp; 0 &amp;amp; \cdots &amp;amp; 0 \\ 0 &amp;amp; \sigma_2 &amp;amp; \cdots &amp;amp; 0 \\ \vdots &amp;amp; \vdots &amp;amp; \ddots &amp;amp; \vdots \\ 0 &amp;amp; 0 &amp;amp; \cdots &amp;amp; \sigma_{N_{ss}} \end{bmatrix} \begin{bmatrix} x_1 \\ x_2 \\ \vdots \\ x_{N_{ss}} \end{bmatrix} + \begin{bmatrix} n&#39;_1 \\ n&#39;_2 \\ \vdots \\ n&#39;_{N_{ss}} \end{bmatrix}$$" vertex="1">
